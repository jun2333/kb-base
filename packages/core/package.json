{
  "name": "@minijun/kb-core",
  "version": "0.1.0",
  "type": "module",
  "description": "本地知识库基座：RAG 引擎 + Agent + 评估框架 + CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jun2333/kb-base.git",
    "directory": "packages/core"
  },
  "bin": {
    "kb": "./bin/kb.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/config/types.d.ts",
      "default": "./dist/config/types.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "types": [
        "./dist/config/types.d.ts"
      ]
    }
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "eval"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.0",
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "chromadb": "^1.9.2",
    "dotenv": "^16.4.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "koa": "^2.15.0",
    "koa-bodyparser": "^4.4.1",
    "langchain": "^0.3.0",
    "openai": "^4.70.0"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@huggingface/transformers": "^4.3.0"
  },
  "peerDependencies": {
    "vitepress": "^1.6.4",
    "@huggingface/transformers": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
